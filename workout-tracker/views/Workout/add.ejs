<!-- Shared header and navigation -->
<%- include('../partials/header.ejs') %>
<%- include('../partials/main_nav.ejs') %>>

<!-- Main Content of add page-->
<div class="container">
    <div class="row">
        <div class="offset-md-3 col-md-6">

            <h1><%= title %></h1>
            <br>

            <form class="form" method="post" action="/workouts/add">

                <div class="form-group mb-3">
                    <label for="nameTextField">Workout Name</label>
                    <input type="text" class="form-control"
                        id="nameTextField"
                        placeholder="Enter workout name"
                        name="name" required>
                </div>

                <div class="form-group mb-3">
                    <label for="typeTextField">Workout Type</label>
                    <input type="text" class="form-control"
                        id="typeTextField"
                        placeholder="Enter workout type"
                        name="type" required>
                </div>

                <div class="form-group mb-3">
                    <label for="durationTextField">Duration (minutes)</label>
                    <input type="number" class="form-control"
                        id="durationTextField"
                        placeholder="Enter duration"
                        name="duration" min="1" required>
                </div>

                <div class="form-group mb-3">
                    <label for="dateTextField">Date</label>
                    <input type="date" class="form-control"
                        id="dateTextField"
                        name="date" required>
                </div>

                <div class="form-group mb-3">
                    <label for="notesTextField">Notes</label>
                    <textarea class="form-control"
                        id="notesTextField"
                        name="notes"
                        placeholder="Enter workout notes"></textarea>
                </div>

                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-plus"></i> Add Workout
                </button>

                <a href="/workouts" class="btn btn-secondary">
                    Cancel
                </a>

            </form>

        </div>
    </div>
</div>

<%- include('../partials/footer.ejs') %>

<!-- Shared footer -->
<%- include('../partials/footer.ejs') %>